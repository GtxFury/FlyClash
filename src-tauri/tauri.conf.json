{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "FlyClash",
  "version": "0.2.9",
  "identifier": "com.flyclash.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "FlyClash",
        "width": 1180,
        "height": 780,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "main-capability"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "resources": [
      "../extra",
      "../tools"
    ],
    "shortDescription": "FlyClash Desktop",
    "longDescription": "FlyClash is a desktop proxy client based on Mihomo.",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
